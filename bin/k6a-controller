#!/system/bin/sh
# ═══════════════════════════════════════════════════════════════════════════════
# k6a-controller  v9.16 — 2-Mode-Architektur: daily + cooking
# SM7150 / sweet_k6a — Lunaris AOSP 3.9 / VantomKernel 4.14.356-openela-rc1
#
# v9.16 Fixes:
#   - THERMAL_RECOVERY: PRE_THERMAL_STATE wird nicht mehr überschrieben (Bugfix)
#   - THERMAL_RECOVERY: Gold bleibt online (cpu_hotplug_offline_gold entfernt)
#   - THERMAL_RECOVERY: sched_recovery() — cpuset top-app=0-7 (Gold nutzbar)
#   - THERMAL_RECOVERY-Loop: sched_recovery() statt sched_daily() im main loop
# ═══════════════════════════════════════════════════════════════════════════════

MODDIR="${1:-/data/adb/modules/Bad4zz89_k6a_tweaks}"

CONFIG="$MODDIR/config/settings.conf"
FREEZE="$MODDIR/config/freeze.conf"
LOG="$MODDIR/config/service.log"
PROFILE="$MODDIR/config/active_profile"
DATA="$MODDIR/webroot/data.txt"
CACHE_TRIGGER="$MODDIR/config/clean_cache_now"
CACHE_LAST="$MODDIR/config/cache_last_cleaned"
RAM_TRIGGER="$MODDIR/config/clean_ram_now"; RAM_LAST="$MODDIR/config/ram_last_cleaned"; RAM_COOLDOWN=900
PAUSE_FILE="$MODDIR/run/pause"
APP_EVENT="$MODDIR/run/app_event"
THERMAL_EVENT="$MODDIR/run/thermal_event"
MANUAL_P="$MODDIR/config/manual_profile"
LOCK="$MODDIR/run/controller.pid"

. "$MODDIR/bin/k6a-lib.sh"

LOG_FILE="$LOG"

TZ_GOLD="/sys/devices/virtual/thermal/thermal_zone25/temp"
TZ_SILVER="/sys/devices/virtual/thermal/thermal_zone24/temp"

STATE="IDLE"; PRE_THERMAL_STATE="COOKING"
LAST_APP=""; LAST_CFG_MTIME=0
LAST_FREEZE_TRIGGER=""; TICK=0; THERMAL_CAPPED=0
PREV_TEMP=-1; TZ_FALLBACK=""; _RIL_PINNED=0; NET_TYPE="lte"; _TEMP_HIST=""
_THERMAL_DAEMONS_STOPPED=0; LAST_ENTER_TS=0; _PAUSED=0; MANUAL="daily"
_LAST_THERMAL_TS=0; _THERMAL_COOLDOWN=30
THERMAL_PREDICT_TEMP=88; THERMAL_PREDICT_RATE=3
GOLD_MAX_NORMAL="2304000"; GOLD_MAX_CAP="2169600"; _THERMAL_PREDICT_RECOVER=80

# ══ PRIMITIVES ════════════════════════════════════════════════════════════════
cfg()  { grep "^${1}=" "$CONFIG" 2>/dev/null | cut -d= -f2; }

_cfg_load_cache() {
    CFG_CPU_HOTPLUG=$(cfg cpu_hotplug_enable);  CFG_CPU_HOTPLUG=${CFG_CPU_HOTPLUG:-0}
    DEBUG=$(cfg debug); [ "$DEBUG" != "1" ] && DEBUG=0
    CFG_DEBUG=$DEBUG
    CFG_DEBOUNCE_WIN=$(cfg debounce_window); CFG_DEBOUNCE_WIN=${CFG_DEBOUNCE_WIN:-5}
    [ "$CFG_DEBOUNCE_WIN" -lt 0 ] 2>/dev/null && CFG_DEBOUNCE_WIN=0
    [ "$CFG_DEBOUNCE_WIN" -gt 60 ] 2>/dev/null && CFG_DEBOUNCE_WIN=60
    CFG_NET_QOS=$(cfg net_qos_enable); CFG_NET_QOS=${CFG_NET_QOS:-0}
    CFG_THRESH_COOKING=$(cfg thermal_cooking_thresh); CFG_THRESH_COOKING=${CFG_THRESH_COOKING:-85}
    [ "$CFG_THRESH_COOKING" -lt 70 ] 2>/dev/null && CFG_THRESH_COOKING=70
    [ "$CFG_THRESH_COOKING" -gt 95 ] 2>/dev/null && CFG_THRESH_COOKING=95
    CFG_THRESH_THERMAL_RECOVER=$(cfg thermal_recover_thresh); CFG_THRESH_THERMAL_RECOVER=${CFG_THRESH_THERMAL_RECOVER:-77}
    CFG_THRESH_COOLDOWN=$(cfg thermal_cooldown_thresh); CFG_THRESH_COOLDOWN=${CFG_THRESH_COOLDOWN:-72}
}

_can_enter() {
    local now diff
    now=$(date +%s); diff=$(( now - LAST_ENTER_TS ))
    [ "$diff" -lt "$CFG_DEBOUNCE_WIN" ] && { warn "Debounce blocked: ${diff}s/${CFG_DEBOUNCE_WIN}s"; return 1; }
    LAST_ENTER_TS=$now; return 0
}

# Direkter Transition-Selektor ohne Debounce (für manuelle Wechsel)
_enter_manual() {
    local target="$1"
    case "$target" in
        COOKING)       _enter_no_debounce enter_cooking       ;;
        DAILY)         _enter_no_debounce enter_daily         ;;
        THERMAL_LIMIT) _enter_no_debounce enter_thermal_limit ;;
        THERMAL_RECOVERY) _enter_no_debounce enter_thermal_recovery ;;
    esac
}

_enter_no_debounce() {
    LAST_ENTER_TS=$(( $(date +%s) - CFG_DEBOUNCE_WIN - 1 ))
    "$@"
}

trim_log() {
    [ -f "$LOG" ] || return
    local lines; lines=$(wc -l < "$LOG" 2>/dev/null) || return
    if [ "$lines" -gt 1000 ]; then
        tail -n 500 "$LOG" > "${LOG}.tmp" && mv "${LOG}.tmp" "$LOG"
        log "Log rotiert (war ${lines} Zeilen, auf 500 gekürzt)"
    fi
}

RELOAD_FLAG=0
trap 'RELOAD_FLAG=1' HUP
DEBUG=$(cfg debug); [ "$DEBUG" != "1" ] && DEBUG=0

# ══ THERMAL MANAGER ═══════════════════════════════════════════════════════════
thermal_full_disable() {
    thermal_stop_daemons
    thermal_trips_raise
    log "Thermal zones: trip-points raised to 95°C (zone24/25/BCL geschützt)"
}

thermal_full_restore() {
    thermal_trips_restore
    thermal_restore_daemons
    log "Thermal zones: restored"
}

_cache_fallback_zone() {
    [ -f "/sys/devices/virtual/thermal/thermal_zone0/temp" ] && \
        TZ_FALLBACK="/sys/devices/virtual/thermal/thermal_zone0/temp"
}

thermal_cpu_temp() {
    local t
    t=$(cat "$TZ_GOLD" 2>/dev/null)
    { [ -n "$t" ] && [ "$t" -gt -27400 ] 2>/dev/null; } && { echo $(( t / 1000 )); return; }
    t=$(cat "$TZ_SILVER" 2>/dev/null)
    { [ -n "$t" ] && [ "$t" -gt -27400 ] 2>/dev/null; } && { echo $(( t / 1000 )); return; }
    [ -n "$TZ_FALLBACK" ] && { t=$(cat "$TZ_FALLBACK" 2>/dev/null); [ -n "$t" ] && echo $(( t / 1000 )) && return; }
    echo 50
}

thermal_predict_check() {
    [ "$STATE" = "COOKING" ] || return 0
    local curr rate predict_thresh
    curr=$(thermal_cpu_temp)
    predict_thresh=$THERMAL_PREDICT_TEMP
    [ "$PREV_TEMP" = "-1" ] && { PREV_TEMP=$curr; return 0; }
    rate=$(( curr - PREV_TEMP )); PREV_TEMP=$curr
    if [ "$THERMAL_CAPPED" = "0" ] && [ "$curr" -ge "$predict_thresh" ] && [ "$rate" -ge "$THERMAL_PREDICT_RATE" ]; then
        w "$P6/scaling_max_freq" "$GOLD_MAX_CAP"; THERMAL_CAPPED=1
        warn "THERMAL_PREDICT: ${curr}°C +${rate}/tick → Gold cap ${GOLD_MAX_CAP}Hz"
    elif [ "$THERMAL_CAPPED" = "1" ] && [ "$curr" -lt "$_THERMAL_PREDICT_RECOVER" ]; then
        w "$P6/scaling_max_freq" "$GOLD_MAX_NORMAL"; THERMAL_CAPPED=0
        log "THERMAL_PREDICT aufgehoben: ${curr}°C"
    fi
}

# ══ DATA.TXT ═══════════════════════════════════════════════════════════════════
write_data() {
    local temp cpu_s cpu_g gpu_mhz gpu_busy
    local btp btp_c bpc bat_str
    local kv kv_real uptime_str
    local ram_used ram_total cache_kb last_clean
    local pause_val freeze_str

    temp=$(thermal_cpu_temp)
    _TEMP_HIST="${temp},${_TEMP_HIST}"; _TEMP_HIST="${_TEMP_HIST:0:79}"
    cpu_s=$(( $(cat "$P0/scaling_cur_freq" 2>/dev/null || echo 0) / 1000 ))
    cpu_g=$(( $(cat "$P6/scaling_cur_freq" 2>/dev/null || echo 0) / 1000 ))
    gpu_mhz=$(( $(cat $GPU/devfreq/cur_freq 2>/dev/null || echo 0) / 1000000 ))
    gpu_busy=$(cat $GPU/gpu_busy_percentage 2>/dev/null || echo "0")

    btp=$(cat /sys/class/power_supply/battery/temp 2>/dev/null || echo 0)
    btp_c="$(( ${btp:-0} / 10 )).$(( ${btp:-0} % 10 ))"
    bpc=$(cat /sys/class/power_supply/battery/capacity 2>/dev/null || echo 0)
    local bst
    bst=$(cat /sys/class/power_supply/battery/status 2>/dev/null || echo "Unknown")
    bat_str="${bpc}% - ${bst}"

    kv=$(uname -r 2>/dev/null || echo "unknown")
    kv_real=$(getprop ro.build.version.kernel 2>/dev/null || echo "")
    local android_ver
    android_ver=$(getprop ro.build.version.release 2>/dev/null || echo "\u2014")

    uptime_str=$(uptime 2>/dev/null | sed 's/.*up //' | sed 's/,.*//' | xargs 2>/dev/null || echo "")

    ram_total=$(grep MemTotal /proc/meminfo 2>/dev/null | awk '{print $2}' || echo 0)
    local ram_free
    ram_free=$(grep MemAvailable /proc/meminfo 2>/dev/null | awk '{print $2}' || echo 0)
    ram_used=$(( ram_total - ram_free ))
    local ram_used_gb ram_total_gb
    ram_used_gb="$(( ${ram_used:-0} / 1048576 )).$(( (${ram_used:-0} % 1048576) * 100 / 1048576 ))"
    ram_total_gb="$(( ${ram_total:-0} / 1048576 )).$(( (${ram_total:-0} % 1048576) * 100 / 1048576 ))"

    cache_kb=$(grep "^Cached:" /proc/meminfo 2>/dev/null | awk '{print $2}' || echo 0)
    local cache_gb
    cache_gb="$(( ${cache_kb:-0} / 1048576 )).$(( (${cache_kb:-0} % 1048576) * 100 / 1048576 ))"

    last_clean=""
    [ -f "$CACHE_LAST" ] && last_clean=$(cat "$CACHE_LAST" 2>/dev/null | head -1 | cut -c1-19 || echo "")

    pause_val="0"; [ -f "$PAUSE_FILE" ] && pause_val="1"

    freeze_str=""
    [ -f "$FREEZE" ] && freeze_str=$(grep -v "^#" "$FREEZE" 2>/dev/null | grep -v "^$" | tr '\n' '|' | sed 's/|$//' || echo "")

    local gpu_driver_desc=""
    [ -f /data/adb/modules/adreno_gpu_driver/module.prop ] && gpu_driver_desc=$(grep "^description=" /data/adb/modules/adreno_gpu_driver/module.prop 2>/dev/null | cut -d= -f2- | head -1)
    [ -z "$gpu_driver_desc" ] && gpu_driver_desc="\u2014"
    local c_cpu_hotplug=${CFG_CPU_HOTPLUG:-0}
    local _ping_val _ping_stale

    _ping_val="\u2014"; _ping_stale="1"
    [ -f "${DATA}.ping" ] && _ping_val=$(cat "${DATA}.ping" 2>/dev/null) && _ping_stale="0"

    cat > "${DATA}.tmp" << EOF
pid=$$
state=$STATE
profile=$(cat "$PROFILE" 2>/dev/null || echo "daily")
manual_profile=$MANUAL
temp=${temp}
cpu_sil_mhz=${cpu_s}
cpu_gold_mhz=${cpu_g}
gpu_mhz=${gpu_mhz}
gpu_busy=${gpu_busy}
gpu_driver=${gpu_driver_desc}
net_type=${NET_TYPE}
net_qos=${CFG_NET_QOS}
net_iface=$(ip route show default 2>/dev/null | awk '{print $5; exit}')
bat=${bat_str}
bat_temp=${btp_c}
kernel=${kv}
kernel_real=${kv_real}
android=${android_ver}
uptime=${uptime_str}
ram_used=${ram_used_gb}
ram_total=${ram_total_gb}
cache_kb=${cache_gb}
last_clean=${last_clean}
pause=${pause_val}
freeze=${freeze_str}
temps=${_TEMP_HIST}
conf_cpu_hotplug=${c_cpu_hotplug}
ping=${_ping_val}
ping_stale=${_ping_stale}
tick=${TICK}
EOF
    printf 'log=' >> "${DATA}.tmp"
    tail -15 "$LOG" 2>/dev/null | tr '\n' '\001' >> "${DATA}.tmp"
    printf '\n' >> "${DATA}.tmp"
    mv "${DATA}.tmp" "$DATA"
}

write_ping() {
    local p
    p=$(ping -c 1 -W 1 8.8.8.8 2>/dev/null | grep -o "time=[0-9.]*" | cut -d= -f2)
    if [ -n "$p" ]; then
        printf '%s\n' "$p" > "${DATA}.ping"
    else
        printf 'timeout\n' > "${DATA}.ping"
    fi
}

# ══ STATE TRANSITIONS ═════════════════════════════════════════════════════════
enter_daily() {
    _can_enter || return 0
    log "→ DAILY"; _cfg_load_cache
    cpu_hotplug_online_all
    cpu_set "schedutil" "576000" "1248000" "652800" "1651200"
    cpu_hotplug_offline_gold
    gpu_daily; io_daily; sched_daily; vm_daily; lmk_default; zram_daily
    lru_gen_enable; sf_daily; wakelock_block
    thermal_daily; restore_battery_spoof
    net_restore; bt_restore
    resetprop persist.vendor.battery.bypass_temp_thresh "41" 2>/dev/null || true
    setprop debug.sf.disable_backpressure   "0" 2>/dev/null || true
    setprop debug.sf.enable_gl_backpressure "1" 2>/dev/null || true
    setprop debug.sf.latch_unsignaled       "0" 2>/dev/null || true
    setprop persist.sys.game_mode           "0" 2>/dev/null || true
    setprop persist.vendor.qti.games.gt.fps "0" 2>/dev/null || true
    w /sys/class/power_supply/battery/system_temp_level "0"
    start logd 2>/dev/null || true; unfreeze_all
    THERMAL_CAPPED=0; _RIL_PINNED=0
    printf '%s' "daily" > "$PROFILE"; STATE="DAILY"
    log "DAILY: Silver 576-1248MHz | Gold offline | GPU 140-267MHz Lock | trips 55°C | WLAN ON"
    ( sleep 2; cpu_set "schedutil" "576000" "1248000" "652800" "1651200" ) &
}

enter_cooking() {
    _can_enter || return 0
    log "→ COOKING"; _cfg_load_cache
    cpu_hotplug_online_all
    thermal_full_disable
    lmh_disable

    # Kill auch msm_thermal falls vorhanden (root cause CPU FREEZE)
    for _te_pid in $(pgrep -f "msm_thermal\|thermal-engine\|mi_thermald\|themal" 2>/dev/null); do
        kill -9 "$_te_pid" 2>/dev/null || true
    done

    cpu_set "schedutil" "1497600" "1804800" "2169600" "2304000"
    gpu_cooking; io_cooking; sched_cooking; vm_cooking; lmk_default; zram_cooking
    lru_gen_enable; sf_daily; wakelock_block
    detect_net_type; net_cooking; bt_cooking; spoof_battery
    resetprop persist.vendor.battery.bypass_temp_thresh "30" 2>/dev/null || true
    setprop debug.sf.disable_backpressure              "1"   2>/dev/null || true
    setprop debug.sf.enable_gl_backpressure            "0"   2>/dev/null || true
    setprop debug.sf.latch_unsignaled                  "0"   2>/dev/null || true
    setprop persist.sys.game_mode                      "1"   2>/dev/null || true
    setprop persist.sys.vulkan.perf_mode               "1"   2>/dev/null || true
    setprop persist.vendor.qti.games.gt.fps            "120" 2>/dev/null || true
    cmd game set --downscale 1.0 "$CODM_PKG"           2>/dev/null || true
    w /sys/class/power_supply/battery/system_temp_level "0"
    tune_cooking "$CODM_PKG"; THERMAL_CAPPED=0
    printf '%s' "cooking" > "$PROFILE"; STATE="COOKING"
    log "COOKING: Silver 1497-1804 | Gold 2169-2304 (schedutil EAS=0) | GPU max 650MHz floor | hotplug=${CFG_CPU_HOTPLUG}"
}

enter_thermal_limit() {
    local temp="${1:-82}"
    warn "→ THERMAL_LIMIT (${temp}°C)"
    cpu_hotplug_online_all
    cpu_set "schedutil" "576000" "1612800" "652800" "1939200"
    w $GPU/thermal_pwrlevel "1"
    w $GPU/devfreq/max_freq "650000000"
    w $GPU/devfreq/min_freq "430000000"
    sched_daily; thermal_full_restore; wakelock_restore
    PRE_THERMAL_STATE="$STATE"
    printf '%s' "gaming" > "$PROFILE"; STATE="THERMAL_LIMIT"
    log "THERMAL_LIMIT: cooling from $PRE_THERMAL_STATE, recover <${CFG_THRESH_THERMAL_RECOVER}°C"
}

enter_thermal_recovery() {
    warn "→ THERMAL_RECOVERY (cooldown)"
    cpu_hotplug_online_all
    cpu_set "schedutil" "576000" "1248000" "652800" "1651200"
    gpu_daily; sched_recovery; io_daily; sf_daily
    _cfg_load_cache
    _LAST_THERMAL_TS=$(date +%s)
    printf '%s' "recovery" > "$PROFILE"; STATE="THERMAL_RECOVERY"
    log "THERMAL_RECOVERY: Gold capped 1651MHz, GPU 267MHz, cooldown ${_THERMAL_COOLDOWN}s <${CFG_THRESH_COOLDOWN}°C"
}

# ══ STARTUP ═══════════════════════════════════════════════════════════════════
_startup() {
    if [ -f "$LOCK" ]; then
        local op; op=$(cat "$LOCK" 2>/dev/null)
        if [ -n "$op" ] && kill -0 "$op" 2>/dev/null; then
            local op_cmd
            op_cmd=$(cat "/proc/$op/cmdline" 2>/dev/null | tr -d '\0')
            case "$op_cmd" in
                *k6a-controller*)
                    err "Controller läuft bereits (PID $op)"; exit 1 ;;
                *)
                    warn "Stale lock (PID $op ist kein k6a-controller: ${op_cmd:-?}) -> ignoriert"
                    rm -f "$LOCK" ;;
            esac
        else
            rm -f "$LOCK"
        fi
    fi
    echo $$ > "$LOCK"
    _cfg_load_cache; _cache_fallback_zone
    detect_kernel_features
    printf 'pid=%s\nstate=STARTING\nprofile=daily\nmanual_profile=daily\n' "$$" > "$DATA" 2>/dev/null || true
    log "k6a-controller v9.16 — 2-Mode (daily/cooking) | SM7150 sweet_k6a | VantomKernel"
    log "GPU: 8 pwrlevels 140-800MHz | Silver: 576-1804MHz | Gold: 652-2304MHz"
    log "Thermal: zone24=Silver zone25=Gold [verifiziert] | BCL zone7/8 geschützt"
    log "Sched: EAS+uclamp+SCHED_CASS (NO WALT, NO schedtune) | HZ=250 | BBR=default"
    [ -n "$TZ_FALLBACK" ] && log "TZ_FALLBACK: zone0 (pm6150-tz) gecacht"
    if [ -f "$PAUSE_FILE" ]; then
        _PAUSED=1; log "⏸ PAUSED"
        thermal_full_restore; restore_battery_spoof; return
    fi
    enter_daily
    pgrep -x "k6a-daemon" >/dev/null 2>&1 || {
        "$MODDIR/bin/k6a-daemon" "$MODDIR" >> "$MODDIR/config/daemon.log" 2>&1 &
        log "k6a-daemon gestartet (PID $!)"
    }
    clean_ram
    [ -f "$CACHE_TRIGGER" ] && { rm -f "$CACHE_TRIGGER"; clean_cache; }
}

# ══ MAIN LOOP ═════════════════════════════════════════════════════════════════
_startup

while true; do
    if [ -f "$PAUSE_FILE" ]; then
        [ "$_PAUSED" = "0" ] && {
            _PAUSED=1; log "⏸ PAUSED"
            thermal_full_restore; restore_battery_spoof
        }
        write_data; sleep 1; TICK=$(( TICK + 1 )); continue
    fi
    [ "$_PAUSED" = "1" ] && { _PAUSED=0; log "▶ RESUMED"; _cfg_load_cache; }

    if [ "$RELOAD_FLAG" = "1" ]; then
        RELOAD_FLAG=0
        _mp=$(cat "$MANUAL_P" 2>/dev/null); [ -n "$_mp" ] && MANUAL=$_mp
        log "SIGHUP: State=$STATE → manual=$MANUAL (Debounce reset)"
        _cfg_load_cache
        _enter_manual "$MANUAL_UC"
        write_data; TICK=$(( TICK + 1 )); sleep 1; continue
    fi

    if [ -f "$THERMAL_EVENT" ]; then
        rm -f "$THERMAL_EVENT" 2>/dev/null
        [ "$STATE" = "COOKING" ] && {
            _tt=$(thermal_cpu_temp)
            [ "${_tt:-0}" -ge "$CFG_THRESH_COOKING" ] && {
                log "Transition: $STATE → THERMAL_LIMIT (${_tt}°C)"
                _enter_no_debounce enter_thermal_limit "$_tt"
                write_data
            }
        }
    fi

    [ -f "$CACHE_TRIGGER" ] && { rm -f "$CACHE_TRIGGER"; clean_cache; }
    if [ -f "$RAM_TRIGGER" ]; then
        _rnow=$(date +%s); _rlast=$(cat "$RAM_LAST" 2>/dev/null || echo 0)
        if [ $(( _rnow - _rlast )) -ge "$RAM_COOLDOWN" ]; then
            clean_ram; echo "$_rnow" > "$RAM_LAST"
        else
            dbg "RAM clean skipped (cooldown ${RAM_COOLDOWN}s)"
        fi
        rm -f "$RAM_TRIGGER"
    fi

    _mt=$(stat -c %Y "$CONFIG" 2>/dev/null || echo 0)
    if [ "$_mt" != "$LAST_CFG_MTIME" ] && [ "$_mt" != "0" ]; then
        LAST_CFG_MTIME=$_mt
        _ms=$(( $(date +%s) - _mt ))
        _cfg_load_cache
        _mp=$(cat "$MANUAL_P" 2>/dev/null); [ -n "$_mp" ] && MANUAL=$_mp
        log "Config mtime → manual=$MANUAL (State=$STATE)"
        [ "$_ms" -ge 5 ] && case "$STATE" in
            COOKING)
                [ "$MANUAL" = "daily" ] && _enter_manual "DAILY" || _enter_manual "COOKING" ;;
            THERMAL_LIMIT) : ;;
            *)
                [ "$MANUAL" = "cooking" ] && _enter_manual "COOKING" || _enter_manual "DAILY" ;;
        esac
        write_data
    fi

    TARGET=""
    _mp=$(cat "$MANUAL_P" 2>/dev/null); [ -n "$_mp" ] && MANUAL=$_mp || MANUAL=${MANUAL:-daily}

    if [ "$STATE" = "THERMAL_LIMIT" ]; then
        temp=$(thermal_cpu_temp)
        if [ "${temp:-99}" -lt "$CFG_THRESH_THERMAL_RECOVER" ]; then
            TARGET="THERMAL_RECOVERY"
            log "Thermal → THERMAL_RECOVERY (${temp}°C)"
        fi
    elif [ "$STATE" = "THERMAL_RECOVERY" ]; then
        temp=$(thermal_cpu_temp)
        _now=$(date +%s); _cd=$(( _now - _LAST_THERMAL_TS ))
        if [ "${temp:-99}" -lt "$CFG_THRESH_COOLDOWN" ] && [ "$_cd" -ge "$_THERMAL_COOLDOWN" ]; then
            TARGET="${PRE_THERMAL_STATE:-COOKING}"
            log "Thermal cooldown → $TARGET (${temp}°C, ${_cd}s)"
        fi
        if [ "${temp:-0}" -ge "$CFG_THRESH_COOKING" ]; then
            TARGET="THERMAL_LIMIT"
            warn "THERMAL_RECOVERY → THERMAL_LIMIT (${temp}°C, still heating)"
        fi
    else
        case "$MANUAL" in cooking) TARGET="COOKING" ;; *) TARGET="DAILY" ;; esac
    fi

    if [ "$STATE" = "COOKING" ]; then
        temp=$(thermal_cpu_temp)
        [ "${temp:-0}" -ge "$CFG_THRESH_COOKING" ] && TARGET="THERMAL_LIMIT"
        thermal_predict_check
        [ $(( TICK % 5 )) -eq 0 ] && tune_cooking "$CODM_PKG"
        [ $(( TICK % 10 )) -eq 0 ] && apply_irq_affinity
        _stl=$(cat /sys/class/power_supply/battery/system_temp_level 2>/dev/null || echo 0)
        [ "${_stl:-0}" -gt "0" ] && w /sys/class/power_supply/battery/system_temp_level "0"

        # GPU thermal management — thermal_pwrlevel overrides devfreq!
        # Use direct pwrlevel writes for instant HW-throttle
        _temp=$(thermal_cpu_temp)
        if [ "${_temp:-0}" -ge 80 ] 2>/dev/null; then
            w $GPU/thermal_pwrlevel "4"          # force level 4 = 355MHz
            w $GPU/devfreq/min_freq "267000000"
            w $GPU/devfreq/max_freq "355000000"
            w $GPU/force_clk_on "0"
            echo "0" > "$GPU/throttling" 2>/dev/null || true
            dbg "GPU thermal 80°C+: thermal_pwrlevel=4 (355MHz)"
        elif [ "${_temp:-0}" -ge 76 ] 2>/dev/null; then
            w $GPU/thermal_pwrlevel "3"          # force level 3 = 430MHz
            w $GPU/devfreq/min_freq "342000000"
            w $GPU/devfreq/max_freq "430000000"
            w $GPU/force_clk_on "1"
            w $GPU/force_bus_on "1"
            echo "0" > "$GPU/throttling" 2>/dev/null || true
            dbg "GPU thermal 76°C+: thermal_pwrlevel=3 (430MHz)"
        elif [ "${_temp:-0}" -ge 72 ] 2>/dev/null; then
            w $GPU/thermal_pwrlevel "2"          # force level 2 = 565MHz
            w $GPU/devfreq/min_freq "430000000"
            w $GPU/devfreq/max_freq "565000000"
            w $GPU/force_clk_on "1"
            w $GPU/force_bus_on "1"
            echo "0" > "$GPU/throttling" 2>/dev/null || true
            dbg "GPU thermal 72°C+: thermal_pwrlevel=2 (565MHz)"
        else
            GPU_MAX_FREQ=800000000
            w $GPU/thermal_pwrlevel "0"          # no throttle
            w $GPU/devfreq/min_freq "565000000"
            w $GPU/devfreq/max_freq "800000000"
            w $GPU/force_clk_on "1"
            w $GPU/force_bus_on "1"
            echo "0" > "$GPU/throttling" 2>/dev/null || true
            dbg "GPU uncapped: 565-800MHz (temp ${_temp}°C)"
        fi

    # CPU FREEZE check — EVERY tick (1s) instead of every 9s
    _cm=$(cat "$P0/scaling_max_freq" 2>/dev/null || echo 9999999)
    _cmin=$(cat "$P0/scaling_min_freq" 2>/dev/null || echo 0)
    _cgm=$(cat "$P6/scaling_max_freq" 2>/dev/null || echo 9999999)
    _cgmin=$(cat "$P6/scaling_min_freq" 2>/dev/null || echo 0)
    _frozen=0
    if [ "$_cm" -lt "500000" ]; then
        _frozen=1
    elif [ "$_cm" = "$_cmin" ] && [ "$_cm" -lt "1600000" ]; then
        _frozen=1
    fi
    if [ "$STATE" = "COOKING" ] && [ "${_cgm}" -lt "2169600" ] 2>/dev/null; then
        dbg "Gold capped at ${_cgm}Hz — recovery"
        lmh_disable
        cpu_set "schedutil" "1497600" "1804800" "2169600" "2304000"
    fi
    if [ "$_frozen" = "1" ]; then
        warn "CPU FREEZE (Silver min=${_cmin} max=${_cm}) — re-apply"
        for _te in $(pgrep -f "msm_thermal\|thermal-engine\|mi_thermald\|themal" 2>/dev/null); do kill -9 "$_te" 2>/dev/null || true; done
        thermal_full_disable; sleep 0.5
        lmh_disable
        cpu_set "schedutil" "1497600" "1804800" "2169600" "2304000"
        w $GPU/thermal_pwrlevel "1"; w $GPU/devfreq/min_freq "565000000"
        w $GPU/devfreq/max_freq "800000000"; w $GPU/force_clk_on "1"
        echo "0" > "$GPU/throttling" 2>/dev/null || true
        w /sys/class/power_supply/battery/system_temp_level "0"
        apply_irq_affinity; log "CPU+GPU+IRQ recovered"
    fi
elif [ "$STATE" = "DAILY" ]; then
    if [ $(( TICK % 6 )) -eq 0 ]; then
        _dm=$(cat "$P0/scaling_max_freq" 2>/dev/null || echo 0)
        if [ "$_dm" -gt "1300000" ] 2>/dev/null; then
            dbg "Daily limits verletzt (max=${_dm}) — re-apply"
            cpu_set "schedutil" "576000" "1248000" "652800" "1651200"
            cpu_hotplug_offline_gold
            sched_daily; gpu_daily
        fi
    fi
elif [ "$STATE" = "THERMAL_RECOVERY" ]; then
    if [ $(( TICK % 6 )) -eq 0 ]; then
        _dm=$(cat "$P0/scaling_max_freq" 2>/dev/null || echo 0)
        if [ "$_dm" -gt "1300000" ] 2>/dev/null; then
            cpu_set "schedutil" "576000" "1248000" "652800" "1651200"
            sched_recovery; gpu_daily
        fi
    fi
    fi

    [ -n "$TARGET" ] && [ "$TARGET" != "$STATE" ] && {
        log "Transition: $STATE → $TARGET"
        case "$TARGET" in
            COOKING)           _enter_manual "COOKING"       ;;
            THERMAL_LIMIT)     _enter_no_debounce enter_thermal_limit ;;
            THERMAL_RECOVERY)  _enter_no_debounce enter_thermal_recovery ;;
            DAILY)             _enter_manual "DAILY"         ;;
        esac
        write_data
    }

    TICK=$(( TICK + 1 ))
    [ $(( TICK % 3 )) -eq 0 ] && write_data
    [ "$STATE" != "COOKING" ] && [ $(( TICK % 10 )) -eq 0 ] && write_ping &
    [ $(( TICK % 10 )) -eq 0 ] && [ "$STATE" = "COOKING" ] && \
        iw dev wlan0 set power_save off 2>/dev/null || true
    [ $(( TICK % 30 )) -eq 0 ] && fstrim /data 2>/dev/null || true
    [ $(( TICK % 600 )) -eq 0 ] && log "♥ $STATE tick=$TICK temp=$(thermal_cpu_temp)°C"
    [ $(( TICK % 1000 )) -eq 0 ] && trim_log
    sleep 1
done
